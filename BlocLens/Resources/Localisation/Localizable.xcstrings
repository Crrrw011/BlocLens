    "map.empty.message" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Gym discovery with Apple MapKit arrives in a later stage." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Apple MapKit을 사용한 암장 검색은 이후 단계에서 제공됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 Apple MapKit 的岩馆发现功能将在后续阶段推出。" } } } },
