    "common.cancel" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "취소" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "common.notNow" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Not now" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "나중에" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不" } } } },
    "common.tryAgain" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } } } },
    "contribution.privacyNote" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Only what you choose is shared. Your private Logbook stays private." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 정보만 공유되며 비공개 로그북은 계속 비공개로 유지됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅分享你主动选择的内容，私人攀爬日志始终保持私密。" } } } },
    "home.card.message" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Your current gym, Projects and recent climbs will appear here." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 암장, 프로젝트 및 최근 클라이밍 기록이 여기에 표시됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你当前的岩馆、项目和最近攀爬记录将显示在这里。" } } } },
    "home.card.title" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Ready for your next climb" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 클라이밍을 준비하세요" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "准备下一次攀爬" } } } },
    "home.contribution.action" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Add details" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "정보 추가" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加详情" } } } },
    "home.contribution.message" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Adding optional route details helps climbers identify the right problem and find useful beta." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택적 루트 정보를 추가하면 다른 클라이머가 문제를 정확히 찾고 유용한 베타를 발견하는 데 도움이 됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加可选的线路详情，可帮助攀岩者识别正确线路并找到实用解法。" } } } },
    "home.contribution.title" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Help make routes easier to find" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "루트를 더 쉽게 찾도록 도와주세요" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "帮助大家更轻松地找到线路" } } } },
    "home.title" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Home" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "홈" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "首页" } } } },
    "logbook.empty.message" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "Private climbing records will appear here after you save a route." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "루트를 저장하면 비공개 클라이밍 기록이 여기에 표시됩니다." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存线路后，私人攀爬记录将显示在这里。" } } } },
    "logbook.empty.title" : { "localizations" : { "en-AU" : { "stringUnit" : { "state" : "translated", "value" : "No Logbook Records Yet" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 로그북 기록이 없습니다" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无攀爬日志" } } } },
