    "settings.deleteAccount.confirmationMessage" : {
      "localizations" : {
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your private data will be permanently deleted. Public contributions you made will remain but will no longer be linked to you."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 데이터는 영구적으로 삭제됩니다. 커뮤니티에 게시한 콘텐츠는 유지되지만 더 이상 사용자와 연결되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的私人数据将被永久删除。您发布的公开内容会保留，但不再与您关联。"
          }
        }
      }
    },
